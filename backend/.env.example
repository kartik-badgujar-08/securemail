# PostgreSQL Connection URL
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/email_security

# Storage configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# TShark configuration (optional explicit path if not in system PATH)
# TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
TSHARK_PATH=
